{
  "name": "@ainlee/dsh-zh-hant-full",
  "version": "1.0.1",
  "type": "module",
  "description": "DeepSeek Harness 繁體中文（台灣用語）語言包。",
  "license": "MIT",
  "author": "ainlee",
  "homepage": "https://github.com/ainlee/dsh-plugins/tree/master/packages/dsh-zh-hant-full",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainlee/dsh-plugins.git",
    "directory": "packages/dsh-zh-hant-full"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "locale",
    "zh-hant",
    "traditional-chinese",
    "taiwan"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
